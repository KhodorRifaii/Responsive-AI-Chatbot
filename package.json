{
  "name": "responsive-ai-chatbot",
  "version": "1.0.0",
  "description": "Responsive AI document chatbot: upload PDF, DOCX, TXT or CSV files and ask questions answered only from their content (RAG).",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "eval": "node eval/run.js"
  },
  "keywords": [
    "rag",
    "chatbot",
    "langchain",
    "gemini",
    "express",
    "bootstrap"
  ],
  "author": "Khodor Rifaii",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@langchain/classic": "^1.0.62",
    "@langchain/core": "^1.5.0",
    "@langchain/google-genai": "^2.3.7",
    "@langchain/textsplitters": "^1.0.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.5",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "papaparse": "^5.7.1",
    "pdf-parse": "^2.4.5"
  }
}
