# Free Google Gemini API key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Gemini model (free tier). Checked 2026-11-24: gemini-3.6-flash and gemini-3.8-flash answered
# 429 (quota) and 503 (busy) on a free key, so the defaults are the two "flash-lite" models.
# If a model gets retired or slow, try gemini-flash-latest.
GEMINI_MODEL=gemini-3.5-flash-lite
# Second model, used automatically when the main one is out of quota, busy, too slow or retired
# (same API key). "none" turns the fallback off.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Seconds each model gets to answer before the fallback is tried
GEMINI_TIMEOUT_SECONDS=30
# Gemini "thinking" (saves free quota). Each model family takes its own setting; the app sends the
# right one per model and nothing for models it has not verified.
# Gemini 3 models: thinking level minimal | low | medium | high ("default" = the model's own setting).
# gemini-3.8-flash has no "minimal": it gets "low" instead.
GEMINI_THINKING_LEVEL=minimal
# Gemini 2.5 models only: thinking tokens, 0 = off ("default" = the model's own setting).
GEMINI_THINKING_BUDGET=0

# Local embedding model (runs on your machine, no key needed)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Model precision (q8 = quantized, low memory; fp32 = full) and CPU threads for embeddings
EMBEDDING_DTYPE=q8
EMBEDDING_THREADS=1
# How the embedding model is called. The models listed in the README ("Choosing an embedder") already have the
# right settings built in, so these are only needed for another model (see its model card). Put values with
# spaces in quotes. A literal \n becomes a newline.
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_DOCUMENT_PREFIX="passage: "
# EMBEDDING_POOLING=mean            # mean | cls | last_token
# EMBEDDING_DIMENSIONS=256          # keep the first N values of each vector (models trained for it, e.g. EmbeddingGemma)
# Sources shown when Gemini cites none: chunks scoring at least max(MIN, RELATIVE x the best score). The listed models have
# their own values built in (MiniLM 0.2 / 0.7); another model gets those until you set them.
# EMBEDDING_SOURCE_MIN_SCORE=0.2
# EMBEDDING_SOURCE_RELATIVE_SCORE=0.7

# Server port
PORT=3000

# Max upload size per file, in MB
MAX_FILE_SIZE_MB=10

# Each visitor has private documents. Limits keep memory within 512 MB.
SESSION_TTL_MINUTES=30
MAX_SESSIONS=100
MAX_CHUNKS_PER_SESSION=1500
MAX_TOTAL_CHUNKS=5000

# Requests per visitor (IP address), so one visitor can't use up the shared free Gemini quota. 0 = no limit.
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_HOUR=100
RATE_LIMIT_UPLOADS_PER_HOUR=30

# Proxies in front of the app, so rate limits see the real visitor IP. 1 = Render (default).
# Use false when nothing sits in front of the app, so X-Forwarded-For can't be faked.
TRUST_PROXY=1
